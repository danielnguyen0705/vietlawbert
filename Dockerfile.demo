# Build the existing pipeline image first: docker compose build app
FROM vietlawbert-app:latest
WORKDIR /app
COPY requirements-demo.txt /tmp/requirements-demo.txt
RUN uv pip install --system --no-cache -r /tmp/requirements-demo.txt
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "cli.demo", "--help"]
