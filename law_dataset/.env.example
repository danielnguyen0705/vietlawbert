# ==========================================
# VietLawBERT Environment Configuration
# ==========================================
# Copy file này thành .env và điền giá trị thực

# --- LLM Providers (Fallback Chain: Groq > OpenRouter > Ollama > GitHub) ---

# 1. Groq Cloud (LPU acceleration, 500+ tokens/s, free tier: 30 RPM)
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (20+ free models, free tier: 20 RPM)
# Lấy tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free

# 3. Ollama (Local, chạy trong Docker)
# Docker: http://ollama:11434
# Local: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
CONTEXTUALIZER_MODEL=qwen2.5:3b-instruct
OLLAMA_API_KEY=

# 4. GitHub Models (Microsoft academic tier, free: 15 RPM)
# Lấy tại: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o

# --- Kafka ingestion (topic v5: corpus VBQPPL sạch, chunk đã bounded) ---
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=vietlawbert-consumers-v5-bounded
KAFKA_TOPIC=law-documents-v5
CONSUMER_DOC_BATCH_SIZE=10
CONSUMER_CHUNK_BATCH_SIZE=64
CONSUMER_FLUSH_INTERVAL_SECONDS=5

# --- Embedding ---
# local: BAAI/bge-m3 chạy bằng PyTorch; openai_compatible: endpoint batch từ xa.
EMBED_PROVIDER=local
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=16
EMBED_MAX_LENGTH=512
EMBED_CPU_INT8=1
EMBED_LOCAL_FILES_ONLY=0

# --- OCR fallback cho HTML/DOCX/PDF scan ---
OCR_ENABLED=1
OCR_INLINE_ENABLED=1
OCR_LANG=vie+eng
OCR_DPI=200
OCR_MAX_PAGES=200
OCR_CONCURRENCY=2
OCR_PAGE_TIMEOUT_SECONDS=60

# Chỉ bắt buộc khi EMBED_PROVIDER=openai_compatible.
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_API_MODEL=
EMBED_API_TIMEOUT=120
