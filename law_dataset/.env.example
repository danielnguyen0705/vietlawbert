# ==========================================
# VietLawBERT Environment Configuration
# ==========================================
# Copy file này thành .env và điền giá trị thực

# --- LLM Providers (Fallback Chain: Groq > OpenRouter > Ollama > GitHub) ---

# 1. Groq Cloud (LPU acceleration, 500+ tokens/s, free tier: 30 RPM)
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (20+ free models, free tier: 20 RPM)
# Lấy tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free

# 3. Ollama (Local, chạy trong Docker)
# Docker: http://ollama:11434
# Local: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
CONTEXTUALIZER_MODEL=qwen2.5:3b-instruct
OLLAMA_API_KEY=

# 4. GitHub Models (Microsoft academic tier, free: 15 RPM)
# Lấy tại: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o
