# ==============================================================================
# VIETLAWBERT ENVIRONMENT CONFIGURATION (V3 ARCHITECTURE - 2026)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HẠ TẦNG LƯU TRỮ TẬP TRUNG (STORAGE & PATHS)
# ------------------------------------------------------------------------------
# Cách đặt đường dẫn cho biến DATA_STORAGE_ROOT:
# - Máy Ubuntu của Đạt: /mnt/data/vietlawbert_data
# - Máy Windows: D:/vietlawbert_data (hoặc để trống để tự động lưu vào ./data)
DATA_STORAGE_ROOT=
PYTHONPATH=.

# ------------------------------------------------------------------------------
# 2. HẠ TẦNG CƠ SỞ DỮ LIỆU LAI (HYBRID STORAGE STACK)
# ------------------------------------------------------------------------------
# Document Store (MongoDB)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=vietlawbert_db

# Knowledge Graph (Neo4j - HIN 22 Quan hệ pháp lý)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vietlawbert2026

# Dense Vector Store (Qdrant - MRL d=256 & Payload Filtering)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=vietlawbert_chunks
QDRANT_VECTOR_DIM=256

# Sparse Lexical Retriever (Elasticsearch 8.x - Vietnamese Legal Analyzer)
ES_HOST=http://localhost:9200
ES_INDEX_NAME=vietlaw_sparse_idx

# In-Memory Graph Cache (Redis - Pre-computed Graph Embeddings 128d)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------------------------
# 3. MÔ HÌNH BIỂU DIỄN & HUẤN LUYỆN (VIETLAWBERT-MRL CORE)
# ------------------------------------------------------------------------------
BASE_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
MAX_SEQ_LENGTH=512
TEMPERATURE=0.05
HIERARCHY_WEIGHT=0.15
# Chọn 'cuda' nếu máy có GPU NVIDIA, 'cpu' nếu máy yếu
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=16

# ------------------------------------------------------------------------------
# 4. CHUỖI ĐIỀU PHỐI LLM ĐA TẦNG (RESILIENT CASCADING FALLBACK)
# ------------------------------------------------------------------------------
# Tầng 1: Cloud SOTA (Grounded Generator & Benchmark Q1)
PRIMARY_LLM_MODEL=gpt-4o
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_API_BASE=https://api.openai.com/v1

# Tầng 2: Cloud Fast (Query Rewriting & Guardrail)
FALLBACK_LLM_MODEL=gemini-1.5-flash
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# Tầng 3: Local Safety Net (vLLM / Ollama - Chi phí 0đ)
# Lưu ý: Khi chạy containerized, đổi localhost thành host.docker.internal
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
CONTEXTUALIZER_MODEL=Qwen/Qwen2.5-14B-Instruct

# ------------------------------------------------------------------------------
# 5. ĐÁNH GIÁ THỰC NGHIỆM KHOA HỌC (BENCHMARK & RQ4 EVALUATION)
# ------------------------------------------------------------------------------
EVAL_MODEL=gpt-4o
RRF_K=60
RETRIEVAL_TOP_K=5
GRAPH_ALPHA=0.2

# ------------------------------------------------------------------------------
# 6. THU THẬP DỮ LIỆU & OCR (DATA ACQUISITION & OCR PIPELINE)
# ------------------------------------------------------------------------------
CRAWLER_CONCURRENCY=8
CRAWLER_DOWNLOAD_DELAY=0.1
CRAWL_PAGE_SIZE=100
OCR_ENABLED=1
OCR_INLINE_ENABLED=1
OCR_LANG=vie+eng
OCR_DPI=200
OCR_MAX_PAGES=200
OCR_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 7. ĐIỀU PHỐI CLOUD GPU (NẾU DÙNG RUNPOD / REMOTE SSH)
# ------------------------------------------------------------------------------
ENABLE_CLOUD_GPU=false
CLOUD_GPU_PROVIDER=runpod
CLOUD_GPU_INSTANCE_ID=
CLOUD_GPU_SSH_HOST=
CLOUD_GPU_SSH_PORT=22
CLOUD_GPU_SSH_USER=root
CLOUD_GPU_SSH_KEY_PATH=~/.ssh/id_rsa
CLOUD_GPU_API_KEY=
CLOUD_AUTO_SHUTDOWN=true
CLOUD_COST_ALERT_THRESHOLD_USD=5.0